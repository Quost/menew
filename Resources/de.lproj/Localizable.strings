/* Ações do Menew na Siri, no app Atalhos e no Spotlight (Sources/Menew/Intents.swift) */
"Keep Mac Awake" = "Mac wach halten";
"Keeps the screen on and the Mac from sleeping, for a while or until you turn it off." = "Hält den Bildschirm an und verhindert den Ruhezustand, für eine Weile oder bis du es ausschaltest.";
"Turn On" = "Einschalten";
"Minutes" = "Minuten";
"Keep awake ${on} for ${minutes} minutes" = "Wach halten ${on} für ${minutes} Minuten";
"Mute Microphone" = "Mikrofon stummschalten";
"Mutes or unmutes the microphone in every app." = "Schaltet das Mikrofon in allen Apps stumm oder wieder an.";
"Muted" = "Stumm";
"Presentation Mode" = "Präsentationsmodus";
"Hides desktop icons, keeps the Mac awake, pauses the clipboard and shows only the icon in the menu bar." = "Blendet Schreibtischsymbole aus, hält den Mac wach, pausiert die Zwischenablage und zeigt in der Menüleiste nur das Symbol.";
"Dark Mode" = "Dunkelmodus";
"Switches macOS between light and dark appearance." = "Wechselt macOS zwischen heller und dunkler Darstellung.";
"Dark" = "Dunkel";
"Start Focus Timer" = "Fokus-Timer starten";
"Starts a focus session with a countdown in the menu bar." = "Startet eine Fokussitzung mit Countdown in der Menüleiste.";
"Capture Screen" = "Bildschirm aufnehmen";
"Select an area or window and annotate the screenshot." = "Wähle einen Bereich oder ein Fenster und beschrifte das Bildschirmfoto.";
"Copy Text from Screen" = "Text vom Bildschirm kopieren";
"Select an area of the screen and copy the text in it, recognized on your Mac." = "Wähle einen Bildschirmbereich und kopiere den Text darin, erkannt auf deinem Mac.";
"Open Clipboard History" = "Verlauf der Zwischenablage öffnen";
"Open Command Palette" = "Befehlspalette öffnen";
"New Note" = "Neue Notiz";
"Creates a note in Menew. The first line is the title." = "Erstellt eine Notiz in Menew. Die erste Zeile ist der Titel.";
"Text" = "Text";
"Work Profile" = "Arbeitsprofil";
"Activate Work Profile" = "Arbeitsprofil aktivieren";
"Opens the profile's apps, arranges its windows and applies its settings." = "Öffnet die Apps des Profils, ordnet die Fenster an und wendet seine Einstellungen an.";
"Profile" = "Profil";
"Clipboard History" = "Zwischenablage-Verlauf";
