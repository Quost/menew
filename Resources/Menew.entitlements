<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <!-- AppleScript para modo escuro e esvaziar a lixeira -->
    <key>com.apple.security.automation.apple-events</key>
    <true/>
    <!-- Próxima reunião (opcional, só quando ligada em Ajustes) -->
    <key>com.apple.security.personal-information.calendars</key>
    <true/>
    <!-- Legendas ao vivo com o microfone (só enquanto estão ligadas) -->
    <key>com.apple.security.device.audio-input</key>
    <true/>
    <!-- Contêiner compartilhado com os widgets (só o arquivo do que eles mostram) -->
    <key>com.apple.security.application-groups</key>
    <array>
        <string>9527N6XKKW.com.matheusquost.menew</string>
    </array>
</dict>
</plist>
