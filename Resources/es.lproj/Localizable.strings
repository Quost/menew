/* Ações do Menew na Siri, no app Atalhos e no Spotlight (Sources/Menew/Intents.swift) */
"Keep Mac Awake" = "Mantener el Mac despierto";
"Keeps the screen on and the Mac from sleeping, for a while or until you turn it off." = "Mantiene la pantalla encendida y evita que el Mac duerma, un rato o hasta que lo apagues.";
"Turn On" = "Activar";
"Minutes" = "Minutos";
"Keep awake ${on} for ${minutes} minutes" = "Mantener despierto ${on} durante ${minutes} minutos";
"Mute Microphone" = "Silenciar el micrófono";
"Mutes or unmutes the microphone in every app." = "Silencia o activa el micrófono en todas las apps.";
"Muted" = "Silenciado";
"Presentation Mode" = "Modo presentación";
"Hides desktop icons, keeps the Mac awake, pauses the clipboard and shows only the icon in the menu bar." = "Oculta los iconos del escritorio, mantiene el Mac despierto, pausa el portapapeles y deja solo el icono en la barra de menús.";
"Dark Mode" = "Modo oscuro";
"Switches macOS between light and dark appearance." = "Cambia macOS entre apariencia clara y oscura.";
"Dark" = "Oscuro";
"Start Focus Timer" = "Iniciar temporizador de enfoque";
"Starts a focus session with a countdown in the menu bar." = "Inicia una sesión de enfoque con cuenta atrás en la barra de menús.";
"Capture Screen" = "Capturar pantalla";
"Select an area or window and annotate the screenshot." = "Selecciona un área o ventana y anota la captura.";
"Copy Text from Screen" = "Copiar texto de la pantalla";
"Select an area of the screen and copy the text in it, recognized on your Mac." = "Selecciona un área de la pantalla y copia su texto, reconocido en tu Mac.";
"Open Clipboard History" = "Abrir historial del portapapeles";
"Open Command Palette" = "Abrir paleta de comandos";
"New Note" = "Nueva nota";
"Creates a note in Menew. The first line is the title." = "Crea una nota en Menew. La primera línea es el título.";
"Text" = "Texto";
"Work Profile" = "Perfil de trabajo";
"Activate Work Profile" = "Activar perfil de trabajo";
"Opens the profile's apps, arranges its windows and applies its settings." = "Abre las apps del perfil, ordena sus ventanas y aplica sus ajustes.";
"Profile" = "Perfil";
"Clipboard History" = "Historial del portapapeles";
